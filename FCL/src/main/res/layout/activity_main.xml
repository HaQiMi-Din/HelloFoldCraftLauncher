<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.MainActivity">
    <VideoView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <!-- 顶部标题横条 -->
    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/title_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/title_bar_padding_horizontal"
        android:paddingEnd="@dimen/title_bar_padding_horizontal"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <!-- 中间标题 -->
        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/title_bar_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="left|center_vertical"
            android:singleLine="true"
            android:text="HelloFoldCraftLauncher"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/title_bar_text_size"
            android:textStyle="bold" />
        <!-- 最小化键 -->
        <FrameLayout
            android:id="@+id/btnMinimize"
            android:layout_width="@dimen/title_button_size"
            android:layout_height="@dimen/title_button_size"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <View
                android:layout_width="@dimen/title_minimize_line_width"
                android:layout_height="@dimen/title_minimize_line_height"
                android:layout_gravity="center"
                android:background="#FFFFFF" />
        </FrameLayout>
        <!-- 退出键（×） -->
        <FrameLayout
            android:id="@+id/btnExit"
            android:layout_width="@dimen/title_button_size"
            android:layout_height="@dimen/title_button_size"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/exit_button_text_size"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
    <!-- 左侧边栏 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/left_menu"
        android:layout_width="@dimen/left_menu_width"
        android:layout_height="0dp"
        android:elevation="100dp"
        app:layout_constraintTop_toBottomOf="@id/title_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ScrollView
            android:id="@+id/left_menu_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/left_menu_padding_vertical"
                android:paddingBottom="@dimen/left_menu_padding_vertical">
                <!-- 账户区域 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_left_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@xml/anim_button_press"
                    android:paddingBottom="@dimen/account_padding_bottom">
                    <com.tungsten.fcllibrary.component.view.FCLImageView
                        android:id="@+id/avatar"
                        android:layout_width="@dimen/avatar_size"
                        android:layout_height="@dimen/avatar_size"
                        android:elevation="50dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:id="@+id/account_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/account_name_margin_top"
                        android:gravity="center"
                        android:singleLine="true"
                        android:text="@string/account_state_no_account"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/account_name_text_size"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/avatar" />
                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:id="@+id/account_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/account_hint_margin_top"
                        android:gravity="center"
                        android:singleLine="true"
                        android:text="@string/account_state_add"
                        android:textColor="#CCCCCC"
                        android:textSize="@dimen/account_hint_text_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/account_name" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <!-- 回到主页 -->
                <LinearLayout
                    android:id="@+id/home_page_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/menu_item_margin_top"
                    android:background="@drawable/bg_left_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@xml/anim_button_press"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/menu_item_padding_vertical"
                    android:paddingBottom="@dimen/menu_item_padding_vertical">
                    <com.tungsten.fcllibrary.component.view.FCLMenuView
                        android:id="@+id/home_page"
                        android:layout_width="@dimen/menu_icon_size"
                        android:layout_height="@dimen/menu_icon_size"
                        android:src="@drawable/ic_baseline_home_24" />
                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/menu_icon_margin_start"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="回到主页"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/menu_item_text_size"
                        android:textStyle="bold" />
                </LinearLayout>
                <!-- 游戏管理 -->
                <LinearLayout
                    android:id="@+id/home_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/menu_item_margin_top"
                    android:background="@drawable/bg_left_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@xml/anim_button_press"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/menu_item_padding_vertical"
                    android:paddingBottom="@dimen/menu_item_padding_vertical">
                    <com.tungsten.fcllibrary.component.view.FCLMenuView
                        android:id="@+id/home"
                        android:layout_width="@dimen/menu_icon_size"
                        android:layout_height="@dimen/menu_icon_size"
                        android:src="@drawable/ic_baseline_refresh_24" />
                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/menu_icon_margin_start"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="游戏管理"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/menu_item_text_size"
                        android:textStyle="bold" />
                </LinearLayout>
                <!-- 版本设置 -->
                <LinearLayout
                    android:id="@+id/manage_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/menu_item_margin_top"
                    android:background="@drawable/bg_left_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@xml/anim_button_press"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/menu_item_padding_vertical"
                    android:paddingBottom="@dimen/menu_item_padding_vertical">
                    <com.tungsten.fcllibrary.component.view.FCLMenuView
                        android:id="@+id/manage"
                        android:layout_width="@dimen/menu_icon_size"
                        android:layout_height="@dimen/menu_icon_size"
                        android:src="@drawable/ic_baseline_build_24" />
                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/menu_icon_margin_start"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="版本设置"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/menu_item_text_size"
                        android:textStyle="bold" />
                </LinearLayout>
                <!-- 游戏下载 -->
                <LinearLayout
                    android:id="@+id/download_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/menu_item_margin_top"
                    android:background="@drawable/bg_left_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@xml/anim_button_press"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/menu_item_padding_vertical"
                    android:paddingBottom="@dimen/menu_item_padding_vertical">
                    <com.tungsten.fcllibrary.component.view.FCLMenuView
                        android:id="@+id/download"
                        android:layout_width="@dimen/menu_icon_size"
                        android:layout_height="@dimen/menu_icon_size"
                        android:src="@drawable/ic_baseline_cloud_download_24" />
                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/menu_icon_margin_start"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="游戏下载"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/menu_item_text_size"
                        android:textStyle="bold" />
                </LinearLayout>
                <!-- 按键 -->
                <LinearLayout
                    android:id="@+id/controller_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/menu_item_margin_top"
                    android:background="@drawable/bg_left_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@xml/anim_button_press"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/menu_item_padding_vertical"
                    android:paddingBottom="@dimen/menu_item_padding_vertical">
                    <com.tungsten.fcllibrary.component.view.FCLMenuView
                        android:id="@+id/controller"
                        android:layout_width="@dimen/menu_icon_size"
                        android:layout_height="@dimen/menu_icon_size"
                        android:src="@drawable/ic_baseline_videogame_asset_24" />
                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/menu_icon_margin_start"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="按键布局"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/menu_item_text_size"
                        android:textStyle="bold" />
                </LinearLayout>
                <!-- 联机设置 -->
                <LinearLayout
                    android:id="@+id/multiplayer_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/menu_item_margin_top"
                    android:background="@drawable/bg_left_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@xml/anim_button_press"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/menu_item_padding_vertical"
                    android:paddingBottom="@dimen/menu_item_padding_vertical">
                    <com.tungsten.fcllibrary.component.view.FCLMenuView
                        android:id="@+id/multiplayer"
                        android:layout_width="@dimen/menu_icon_size"
                        android:layout_height="@dimen/menu_icon_size"
                        android:src="@drawable/ic_outline_account_tree_24" />
                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/menu_icon_margin_start"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="联机设置"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/menu_item_text_size"
                        android:textStyle="bold" />
                </LinearLayout>
                <!-- 设置管理 -->
                <LinearLayout
                    android:id="@+id/setting_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/menu_item_margin_top"
                    android:background="@drawable/bg_left_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@xml/anim_button_press"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/menu_item_padding_vertical"
                    android:paddingBottom="@dimen/menu_item_padding_vertical">
                    <com.tungsten.fcllibrary.component.view.FCLMenuView
                        android:id="@+id/setting"
                        android:layout_width="@dimen/menu_icon_size"
                        android:layout_height="@dimen/menu_icon_size"
                        android:src="@drawable/ic_baseline_settings_24" />
                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/menu_icon_margin_start"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="设置管理"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/menu_item_text_size"
                        android:textStyle="bold" />
                </LinearLayout>
                <!-- 回到上级 -->
                <LinearLayout
                    android:id="@+id/back_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/menu_item_margin_top"
                    android:background="@drawable/bg_left_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@xml/anim_button_press"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/menu_item_padding_vertical"
                    android:paddingBottom="@dimen/menu_item_padding_vertical">
                    <com.tungsten.fcllibrary.component.view.FCLMenuView
                        android:id="@+id/back"
                        android:layout_width="@dimen/menu_icon_size"
                        android:layout_height="@dimen/menu_icon_size"
                        android:src="@drawable/ic_baseline_arrow_back_24" />
                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/menu_icon_margin_start"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="回到上级"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/menu_item_text_size"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/right_menu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <com.tungsten.fcllibrary.component.view.FCLDynamicIsland
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <com.tungsten.fcllibrary.component.view.FCLUILayout
        android:id="@+id/ui_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/title_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/left_menu" />
    <!-- 右下角启动按钮 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/start"
        android:layout_width="@dimen/start_button_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/start_button_margin_end"
        android:layout_marginBottom="@dimen/start_button_margin_bottom"
        android:background="@drawable/bg_game_menu"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/start_button_padding"
        android:stateListAnimator="@xml/anim_scale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:id="@+id/start_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/go_setting"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.tungsten.fcllibrary.component.view.FCLTextView
                android:id="@+id/text_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="启动游戏"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/start_button_text_size"
                android:textStyle="bold" />
            <com.tungsten.fcllibrary.component.view.FCLTextView
                android:id="@+id/version_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/version_name_margin_top"
                android:textColor="#DDDDDD"
                android:textSize="@dimen/version_name_text_size"
                tools:text=" " />
        </LinearLayout>
        <com.tungsten.fcllibrary.component.view.FCLImageButton
            android:id="@+id/go_setting"
            android:layout_width="@dimen/go_setting_button_size"
            android:layout_height="@dimen/go_setting_button_size"
            android:src="@drawable/ic_baseline_settings_24"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <com.tungsten.fcllibrary.component.view.FCLImageView
            android:id="@+id/icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <com.tungsten.fcllibrary.component.view.FCLProgressBar
            android:id="@+id/version_progress"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/jar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/version"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>
